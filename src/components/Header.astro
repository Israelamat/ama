---
import { brand, links } from '../config/site';

const nav = [
  { label: 'Manifiesto', href: '#manifiesto' },
  { label: 'Catálogo', href: '#catalogo' },
  { label: 'Terapias', href: '#terapias' },
  { label: 'Visítanos', href: '#visitanos' },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow] duration-500"
>
  <div class="wrap">
    <div class="flex h-[var(--header-h)] items-center justify-between gap-6">
      <a href="#top" class="relative z-10 flex items-center" aria-label={`${brand.name}, inicio`}>
        <img
          src={brand.logo}
          alt={brand.name}
          width={brand.logoW}
          height={brand.logoH}
          class="h-[46px] w-auto"
          decoding="async"
        />
      </a>

      <nav class="hidden items-center gap-9 lg:flex" aria-label="Secciones de la página">
        {nav.map((item) => (
          <a
            href={item.href}
            class="link-underline font-meta text-[0.78rem] font-black tracking-[0.18em] uppercase opacity-80 transition-opacity duration-300 hover:opacity-100"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={links.catalogo}
          data-shop-link
          class="btn btn-primary hidden !px-6 !py-3 text-[0.8rem] sm:inline-flex"
        >
          <span data-shop-label>Entrar en la tienda</span>
          <span class="btn-arrow" aria-hidden="true">
            →
          </span>
        </a>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="menu-movil"
          class="relative z-10 grid h-11 w-11 place-items-center rounded-full border border-line bg-card/80 transition-colors duration-300 hover:border-mint lg:hidden"
        >
          <span class="sr-only">Abrir menú</span>
          <span class="flex w-4 flex-col gap-[5px]" aria-hidden="true">
            <span
              class="block h-px w-full bg-ink transition-transform duration-300"
              data-menu-line="top"
            ></span>
            <span
              class="block h-px w-full bg-ink transition-transform duration-300"
              data-menu-line="bottom"
            ></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <!--
    `overflow-y-auto` + `inert` resuelven los dos fallos que tenía: en pantallas
    cortas el último enlace quedaba fuera de alcance, y el menú cerrado seguía
    siendo tabulable y legible por lectores de pantalla. El stagger se calcula
    en el marcado con `--menu-delay` en lugar de calcularlo desde JS.
  -->
  <div
    id="menu-movil"
    data-menu
    inert
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 -z-10 flex flex-col justify-between overflow-y-auto overscroll-contain bg-ink px-[clamp(1.25rem,4vw,3rem)] pt-[calc(var(--header-h)+2rem)] pb-12 text-paper opacity-0 lg:hidden"
  >
    <nav class="flex flex-col" aria-label="Menú móvil">
      {nav.map((item, index) => (
        <a
          href={item.href}
          data-menu-link
          style={`--menu-delay: ${0.06 * (index + 1)}s`}
          class="display-md border-b border-white/10 py-5"
        >
          <span class="font-meta text-[0.7rem] tracking-[0.3em] text-mint">0{index + 1}</span>
          <span class="ml-3">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="mt-12 space-y-6">
      <a href={links.catalogo} data-shop-link class="btn btn-mint btn-lg w-full">
        <span data-shop-label>Entrar en la tienda</span>
        <span class="btn-arrow" aria-hidden="true">
          →
        </span>
      </a>
      <p class="text-sm text-paper/70">
        Avenida de Elda 68, Petrer (Alicante) · L-V 10:00–13:30 y 17:00–20:00 · Sáb 10:30–13:30
      </p>
    </div>
  </div>
</header>
